table fraud_clean
	lineageTag: 87c09358-37d0-4911-a452-9e319e06ca9f

	measure Transactions = COUNTROWS(fraud_clean)
		formatString: #,0
		lineageTag: 6918e269-eb6d-4313-b8e7-221944243b97

	measure 'Fraud Cases' = CALCULATE(COUNTROWS(fraud_clean), fraud_clean[Fraudulent] = TRUE())
		formatString: #,0
		lineageTag: 694808b1-3fab-4a78-ba12-9c9ae88ac255

	measure 'Fraud Rate' = DIVIDE([Fraud Cases], [Transactions])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ab92a7de-51cd-47ea-8fb0-333d5acb2c72

	measure 'Overall Fraud Rate' = CALCULATE([Fraud Rate], ALL(fraud_clean))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9d479c27-fa45-4988-89c2-6cda0033417f

	measure 'Gap vs Overall (pts)' = ([Fraud Rate] - [Overall Fraud Rate]) * 100
		formatString: 0.00
		lineageTag: ee84d249-46ab-4f77-b089-b3c6f50c7801

	measure 'Rate Color' = IF([Fraud Rate] > [Overall Fraud Rate], "#D64550", "#2B6CB0")

	measure 'Heat Color' =
			VAR g = [Gap vs Overall (pts)]
			RETURN SWITCH(TRUE(),
			    ISBLANK([Fraud Rate]), BLANK(),
			    g >= 1, "#E06666",
			    g >= 0.5, "#F4B6B6",
			    g > -0.5, "#F3F2F1",
			    g > -1, "#B7D3F0",
			    "#6FA8DC")

	column Transaction_ID
		dataType: string
		lineageTag: 491fba7e-27fb-48cc-bcaf-bed840079d73
		summarizeBy: none
		sourceColumn: Transaction_ID

